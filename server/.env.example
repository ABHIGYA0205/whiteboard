# Server Environment Configuration
PORT=4001
MONGO_URI=mongodb://127.0.0.1:27017/whiteboard
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001
HF_TOKEN=your_huggingface_token_here
BOARD_SECRET=your_32_byte_secret_here # Required across restarts to keep signed board tokens valid. If unset, a random secret is generated per boot.

# Pollinations secret key (sk_...). Enables sketch-guided image generation.
# Without it the AI image feature is text-only.
POLLINATIONS_API_KEY=

# Vercel Blob Storage Configuration (Preferred image backend)
# Note: Leave unset to fall back to S3/local.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# S3-Compatible Storage Configuration
# Note: Leaving S3_* unset falls back to writing images to local disk in uploads/ (lost on deploy / ephemeral filesystems).
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com # S3-compatible service endpoint URL (optional; for R2, B2, MinIO)
S3_REGION=auto                                           # S3 region (optional; defaults to "auto" or "us-east-1")
S3_BUCKET=my-whiteboard-bucket                           # S3 bucket name for persisting uploaded images
S3_ACCESS_KEY_ID=your_s3_access_key_id                   # S3 access key ID for authentication
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key           # S3 secret access key for authentication
S3_PUBLIC_BASE_URL=https://cdn.example.com               # Public CDN or custom domain URL serving uploaded assets
