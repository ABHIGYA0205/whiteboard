+++ b/tests/boardStore.sync.test.ts
@@ -0,0 +1,77 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { useBoardStore } from "@/store/boardStore";
+import type { WhiteboardElement } from "@shared/types";
+
+const el = (id: string, x = 0): WhiteboardElement =>
+  ({ id, type: "rectangle", x, y: 0, width: 10, height: 10, strokeColor: "#fff", strokeWidth: 2, points: [] } as WhiteboardElement);
+
+const reset = () => useBoardStore.getState().loadBoard([], 0);
+const ids = () => useBoardStore.getState().elements.map((e) => e.id).sort();
+
+test("REGRESSION: server snapshot after reconnect must not wipe my unsaved shapes", () => {
+  reset();
+  // I draw two shapes; only the first has reached the server yet.
+  useBoardStore.getState().commitElements([el("saved")]);
+  useBoardStore.getState().commitElements([el("saved"), el("in-flight")]);
+
+  // Socket reconnects -> board:state arrives with a stale snapshot.
+  useBoardStore.getState().syncElements([el("saved")], 3);
+
+  assert.deepEqual(ids(), ["in-flight", "saved"], "both my shapes must survive");
+});
+
+test("REGRESSION: a peer's replace-elements snapshot must not delete my newest stroke", async () => {
+  reset();
+  useBoardStore.getState().commitElements([el("peer-shape")]);
+  useBoardStore.getState().commitElements([el("peer-shape"), el("my-stroke")]);
+
+  // Peer drags a shape -> emits their whole board, which predates my stroke.
+  await new Promise((resolve) => setTimeout(resolve, 700)); // past the edit grace window
+  useBoardStore.getState().mergeRemoteElements([el("peer-shape", 80)]);
+
+  assert.deepEqual(ids(), ["my-stroke", "peer-shape"], "my stroke must survive");
+  assert.equal(useBoardStore.getState().elements.find((e) => e.id === "peer-shape")?.x, 80);
+});
+
+test("a shape I am actively dragging is not reverted by a peer snapshot", () => {
+  reset();
+  useBoardStore.getState().commitElements([el("mine", 0)]);
+  useBoardStore.getState().setActiveElementIds(["mine"]);
+
+  useBoardStore.getState().mergeRemoteElements([el("mine", 900)]); // peer's stale copy
+
+  assert.equal(useBoardStore.getState().elements[0].x, 0, "in-flight shape wins");
+  useBoardStore.getState().setActiveElementIds([]);
+});
+
+test("a peer's delete still propagates through tombstones", () => {
+  reset();
+  useBoardStore.getState().commitElements([el("a"), el("b")]);
+  useBoardStore.getState().mergeRemoteElements([el("a")], ["b"]);
+  assert.deepEqual(ids(), ["a"]);
+});
+
+test("remote clear is tombstoned so old elements cannot merge back in", () => {
+  reset();
+  useBoardStore.getState().commitElements([el("a"), el("b")]);
+  useBoardStore.getState().applyRemoteClear();
+  assert.deepEqual(ids(), []);
+  useBoardStore.getState().mergeRemoteElements([el("a"), el("b")]);
+  assert.deepEqual(ids(), [], "already-cleared elements must stay cleared");
+});
+
+test("undo restores a deleted element and clears its tombstone", () => {
+  reset();
+  useBoardStore.getState().commitElements([el("a")]);
+  useBoardStore.getState().commitElements([el("a"), el("b")]);
+  const selected = useBoardStore.getState().selectElement("b");
+  void selected;
+  useBoardStore.getState().deleteSelected();
+  assert.deepEqual(ids(), ["a"]);
+  useBoardStore.getState().undo();
+  assert.deepEqual(ids(), ["a", "b"]);
+  // A late peer upsert must not be swallowed by a stale tombstone.
+  useBoardStore.getState().mergeRemoteElements([el("b", 42)]);
+  assert.deepEqual(ids(), ["a", "b"]);
+});
diff --git a/tests/collab.merge.test.ts b/tests/collab.merge.test.ts
new file mode 100644
index 0000000..79c3f58
--- /dev/null
+++ b/tests/collab.merge.test.ts
@@ -0,0 +1,72 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mergeElementLists } from "@shared/collab";
+import type { WhiteboardElement } from "@shared/types";
+
+const el = (id: string, x = 0): WhiteboardElement =>
+  ({ id, type: "rectangle", x, y: 0, width: 10, height: 10, strokeColor: "#fff", strokeWidth: 2, points: [] } as WhiteboardElement);
+
+test("a stale remote snapshot must never delete local-only elements", () => {
+  // Peer's view does not contain b1 yet -> b1 must survive.
+  const result = mergeElementLists({
+    local: [el("a1"), el("b1", 50)],
+    incoming: [el("a1")]
+  });
+  assert.deepEqual(result.elements.map((e) => e.id).sort(), ["a1", "b1"]);
+});
+
+test("remote upserts still update elements the local user is not touching", () => {
+  const result = mergeElementLists({
+    local: [el("a1", 0)],
+    incoming: [el("a1", 999)],
+    now: Date.now()
+  });
+  assert.equal(result.elements[0].x, 999);
+  assert.equal(result.changed, true);
+});
+
+test("an in-flight local edit wins over a stale copy of the same element", () => {
+  const now = Date.now();
+  const result = mergeElementLists({
+    local: [el("a1", 500)],
+    incoming: [el("a1", 10)],
+    localEditTimes: new Map([["a1", now - 500]]),
+    now
+  });
+  assert.equal(result.elements[0].x, 500);
+});
+
+test("the element being edited is never yanked away", () => {
+  const result = mergeElementLists({
+    local: [el("a1", 500)],
+    incoming: [el("a1", 10)],
+    editingElementId: "a1"
+  });
+  assert.equal(result.elements[0].x, 500);
+});
+
+test("explicit tombstones from a peer do delete elements", () => {
+  const result = mergeElementLists({
+    local: [el("a1"), el("b1")],
+    incoming: [el("a1")],
+    deletedIds: ["b1"]
+  });
+  assert.deepEqual(result.elements.map((e) => e.id), ["a1"]);
+  assert.ok(result.tombstones.has("b1"));
+});
+
+test("local tombstones are respected and never resurrected", () => {
+  const result = mergeElementLists({
+    local: [el("a1")],
+    incoming: [el("a1"), el("dead")],
+    localTombstones: ["dead"]
+  });
+  assert.deepEqual(result.elements.map((e) => e.id), ["a1"]);
+});
+
+test("union is order-stable and idempotent", () => {
+  const first = mergeElementLists({ local: [el("a")], incoming: [el("b"), el("c")] });
+  const second = mergeElementLists({ local: first.elements, incoming: [el("b"), el("c")] });
+  assert.deepEqual(second.elements.map((e) => e.id), ["a", "b", "c"]);
+  assert.equal(second.changed, false);
+});
diff --git a/tests/server.collab.e2e.mjs b/tests/server.collab.e2e.mjs
new file mode 100644
index 0000000..e3e6efb
--- /dev/null
+++ b/tests/server.collab.e2e.mjs
@@ -0,0 +1,81 @@
+// End-to-end: two clients, one patched server, concurrent saves + socket traffic.
+import { io } from "socket.io-client";
+const API = "http://127.0.0.1:4001";
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+const el = (id, x=0) => ({ id, type:"rectangle", x, y:0, width:10, height:10, strokeColor:"#fff", strokeWidth:2, points:[] });
+const post = (p,b) => fetch(API+p,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(b||{})}).then(r=>r.json());
+const put = (id,b) => fetch(`${API}/board/${id}`,{method:"PUT",headers:{"content-type":"application/json"},body:JSON.stringify(b)});
+const getId = async id => (await fetch(`${API}/board/${id}`)).json();
+
+const results = [];
+const check = (name, pass, detail) => { results.push({name,pass,detail}); console.log(`${pass?"PASS":"FAIL"}  ${name}${detail?"  "+JSON.stringify(detail):""}`); };
+
+// --- 1. two stale full-array saves must not clobber each other (server-side merge)
+{
+  const board = await post("/board");
+  // Alice saves {a1}; Bob (whose view predates a1) saves {b1} one after the other.
+  await put(board.id, { elements: [el("a1")], version: 0 });
+  await put(board.id, { elements: [el("b1")], version: 1 });
+  const after = await getId(board.id);
+  const ids = after.elements.map(e => e.id).sort();
+  check("concurrent partial saves keep both clients' work (REST)", JSON.stringify(ids)===JSON.stringify(["a1","b1"]), ids);
+}
+
+// --- 2. explicit delete still deletes
+{
+  const board = await post("/board");
+  await put(board.id, { elements: [el("a1"), el("b1")], version: 0 });
+  await put(board.id, { elements: [el("a1")], version: 1, deletedIds: ["b1"] });
+  const after = await getId(board.id);
+  check("explicit delete persists", JSON.stringify(after.elements.map(e=>e.id))===JSON.stringify(["a1"]), after.elements.map(e=>e.id));
+}
+
+// --- 3. a deleted element cannot be resurrected by the other client's stale snapshot
+{
+  const board = await post("/board");
+  await put(board.id, { elements: [el("a1"), el("b1")], version: 0 });
+  await put(board.id, { elements: [el("a1")], version: 1, deletedIds: ["b1"] });
+  await put(board.id, { elements: [el("a1"), el("b1")], version: 2 }); // stale peer re-saves b1
+  const after = await getId(board.id);
+  check("deleted element is not resurrected by a stale save", !after.elements.some(e=>e.id==="b1"), after.elements.map(e=>e.id));
+}
+
+// --- 4. realtime: Alice drawing must never make Bob's in-progress board shrink
+{
+  const board = await post("/board");
+  const mk = (name) => new Promise(res => {
+    const s = io(API, { transports:["websocket"], auth:{userId:name} });
+    s.on("connect", () => { s.emit("join-board",{boardId:board.id,userName:name}); res(s); });
+  });
+  const alice = await mk("alice"), bob = await mk("bob");
+  await sleep(400);
+  let bobLastReplace = null;
+  bob.on("replace-elements", p => { bobLastReplace = p; });
+  // Bob draws two shapes and pushes his board.
+  bob.emit("draw", { boardId: board.id, element: el("b1") });
+  bob.emit("draw", { boardId: board.id, element: el("b2") });
+  await put(board.id, { elements: [el("b1"), el("b2")], version: 0 });
+  // Alice, who has not received those draws yet in a real race, sends only her own.
+  alice.emit("replace-elements", { boardId: board.id, elements: [el("a1")], version: 1 });
+  await sleep(900);
+  const after = await getId(board.id);
+  const ids = after.elements.map(e=>e.id).sort();
+  check("peer replace-elements does not erase other users' shapes", JSON.stringify(ids)===JSON.stringify(["a1","b1","b2"]), ids);
+  check("replace-elements broadcast carries tombstones", Array.isArray(bobLastReplace?.deletedIds), {deletedIds: bobLastReplace?.deletedIds});
+  alice.close(); bob.close();
+}
+
+// --- 5. board:state on reconnect is a snapshot, and the client merge keeps local work
+{
+  const board = await post("/board");
+  const s = io(API,{transports:["websocket"],auth:{userId:"carol"}});
+  await new Promise(r=>s.on("connect",r));
+  s.emit("join-board",{boardId:board.id,userName:"carol"});
+  const state = await new Promise(r=>s.once("board:state",r));
+  check("join delivers board:state for the client-side merge", Array.isArray(state.elements), {version:state.version});
+  s.close();
+}
+
+const failed = results.filter(r=>!r.pass).length;
+console.log(`\n${results.length-failed}/${results.length} passed`);
+process.exit(failed?1:0);
